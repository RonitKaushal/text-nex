{
  "name": "bulk-whatsapp",
  "productName": "Bulk WhatsApp",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3001 && cross-env NODE_ENV=development electron .\"",
    "icons:build": "node scripts/build-electron-icon.mjs",
    "electron:build": "npm run icons:build && npm run build && electron-builder --win",
    "build": "npm run icons:build && vite build",
    "build:ui": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@emoji-mart/data": "^1.2.1",
    "antd": "^5.26.4",
    "axios": "^1.10.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.7.3",
    "emoji-mart": "^5.6.0",
    "keytar": "^7.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "terser": "^5.43.1",
    "vite": "^7.0.3",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.textnexus.bulkwhatsapp",
    "productName": "Bulk WhatsApp",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "compression": "maximum",
    "removePackageScripts": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "electron-core/**/*",
      "!electron-core/node_modules/**/.cache/**",
      "!electron-core/node_modules/@realvare/**",
      "!**/*.{md,map,ts}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin"
    ],
    "asarUnpack": [
      "**/node_modules/baileys/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bulk WhatsApp"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon-512x512.png"
    }
  }
}
