{
  "name": "lead-gen-desktop",
  "version": "2.0.0",
  "description": "Lead Gen – React + Node inside Electron, SQLite DB, Login, Generate, Share to backend",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "npm run build:frontend && electron .",
    "dev": "npm run build:frontend && cross-env NODE_ENV=development electron .",
    "build:frontend": "cd frontend && npm run build",
    "postinstall": "npx playwright install chromium",
    "pack": "electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder"
  },
  "build": {
    "appId": "com.leadgen.desktop",
    "productName": "Lead Gen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!frontend/node_modules",
      "!dist"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "playwright": "^1.40.0",
    "puppeteer": "^24.38.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}
