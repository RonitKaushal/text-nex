{
  "name": "textnexus-app",
  "private": true,
  "version": "6.1.0",
  "type": "module",
  "description": "TextNexus - Multi-Account Messaging Application",
  "author": "TextNexus Team",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "electron-dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron-pack": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder",
    "electron-dist": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder --publish=never",
    "build-win": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder --win",
    "build-win-portable": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder --win portable",
    "build-mac": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder --mac --publish never",
    "build-mac-ci": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder --mac dmg zip --x64 --publish never && electron-builder --mac dmg zip --arm64 --publish never",
    "build-all": "npm run build && node scripts/protect-embedded-apps.mjs && electron-builder --win --mac --linux --publish never",
    "protect-apps": "node scripts/protect-embedded-apps.mjs",
    "clean": "rimraf dist release build-protected",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "build": {
    "appId": "com.textnexus.app",
    "productName": "TextNexus",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "asar": true,
    "publish": null,
    "asarUnpack": [
      "public/**/*.{png,ico}"
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/logo.png",
      "public/logo_Black.png",
      "public/logo_light.png",
      "public/favicon-32.png",
      "public/favicon-16.png",
      "package.json",
      "!**/*.{md,map}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/gmail-sol.mp4",
      "!**/*.mp4",
      "!dist/**/*.mp4"
    ],
    "extraResources": [
      {
        "from": "public/logo.png",
        "to": "icons/logo.png"
      },
      {
        "from": "public/logo_light.png",
        "to": "icons/logo_light.png"
      },
      {
        "from": "public/logo_Black.png",
        "to": "icons/logo_Black.png"
      },
      {
        "from": "public/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "public/favicon-32.png",
        "to": "icons/favicon-32.png"
      },
      {
        "from": "build-protected/bulk-whatsapp/dist",
        "to": "bulk-whatsapp/dist"
      },
      {
        "from": "build-protected/bulk-whatsapp/electron",
        "to": "bulk-whatsapp/electron"
      },
      {
        "from": "build-protected/bulk-whatsapp/electron-core",
        "to": "bulk-whatsapp/electron-core"
      },
      {
        "from": "build-protected/lead-gen-app",
        "to": "lead-gen-app"
      }
    ],
    "extraFiles": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "publisherName": "TextNexus",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TextNexus",
      "include": "build/installer.nsh",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "TextNexus-${version}-${arch}",
      "icon": "build/icon.png",
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/logo.png",
      "category": "Network",
      "executableName": "textnexus",
      "synopsis": "TextNexus messaging hub",
      "description": "Multi-account messaging application"
    }
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "electron-log": "^5.4.4",
    "electron-store": "^10.1.0",
    "electron-unhandled": "^5.0.0",
    "p-limit": "^3.1.0",
    "pidusage": "^4.0.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.21.0",
    "autoprefixer": "^10.4.18",
    "axios": "^1.11.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "42.3.3",
    "electron-builder": "^25.0.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "javascript-obfuscator": "^5.5.0",
    "jwt-decode": "^4.0.0",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^8.0.0"
  }
}
